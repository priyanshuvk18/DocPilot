# ==============================================================================
# DocPilot — Environment Variables Template
# ==============================================================================
# Copy this file to .env (root) AND apps/api/.env for local dev.
# NEVER commit real secrets. All values here are safe placeholders.
#
# Setup guide: see README.md §Quick Start
# ==============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ─── Database (Postgres + pgvector) ──────────────────────────────────────────
# Local: docker-compose brings up Postgres on 5432
DATABASE_URL=postgresql+asyncpg://docpilot:docpilot_dev@localhost:5432/docpilot
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Redis ────────────────────────────────────────────────────────────────────
# Local: docker-compose brings up Redis on 6379
REDIS_URL=redis://localhost:6379/0

# ─── Supabase Auth ────────────────────────────────────────────────────────────
# Create a project at https://supabase.com → Settings → API
# See README.md §Supabase Setup for step-by-step instructions
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# Local dev only — set to "true" to skip JWT verification (uses a mock user)
# NEVER set true in staging or production
AUTH_DISABLED=true

# ─── LLM — Anthropic Claude ───────────────────────────────────────────────────
# Get key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL_ANSWER=claude-sonnet-4-5
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5
ANTHROPIC_MAX_TOKENS=2048

# ─── Embeddings — Voyage AI ───────────────────────────────────────────────────
# Get key at https://dash.voyageai.com
# NOTE: voyage-3-lite produces 512-dim vectors. The DB schema uses vector(512).
# See SCHEMA_DEVIATION.md for rationale.
VOYAGE_API_KEY=pa-your-voyage-key-here
VOYAGE_EMBEDDING_MODEL=voyage-3-lite
VOYAGE_RERANK_MODEL=rerank-2
VOYAGE_EMBEDDING_DIM=512

# ─── Object Storage (S3-compatible) ───────────────────────────────────────────
# Local: docker-compose brings up MinIO on 9000 (API) and 9001 (console)
# Production: use Supabase Storage or AWS S3
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin_dev
STORAGE_BUCKET_NAME=docpilot-documents
STORAGE_REGION=us-east-1

# ─── Observability ────────────────────────────────────────────────────────────
# Sentry: https://sentry.io — leave empty to disable
SENTRY_DSN=

# Langfuse: https://cloud.langfuse.com — leave empty to disable
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── Rate Limits ──────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_TOKENS_PER_DAY=500000

# ─── Frontend (Next.js public vars — prefix NEXT_PUBLIC_) ────────────────────
# These are safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
